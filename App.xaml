<Application x:Class="ModelDesk.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <!-- Gallery App.xaml 原始 Light/Dark/HighContrast 资源映射。 -->
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="Transparent"/>
     <StaticResource x:Key="GalleryBackgroundBrush" ResourceKey="SolidBackgroundFillColorBaseBrush"/>
     <StaticResource x:Key="GalleryBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="Transparent"/>
     <StaticResource x:Key="GalleryBackgroundBrush" ResourceKey="SolidBackgroundFillColorBaseBrush"/>
     <StaticResource x:Key="GalleryBorderBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="GalleryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="GalleryBorderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <!-- Gallery Styles/TextBlock.xaml 的可访问标题层级。 -->
   <Style x:Key="SubtitleHeadingTextBlockStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
   </Style>
   <Style x:Key="BodyStrongHeadingTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level3"/>
   </Style>
   <!-- Gallery SettingsPage.xaml 的原生分节排版；不引入其 Toolkit/实验 SDK 依赖。 -->
   <x:Double x:Key="SettingsCardSpacing">4</x:Double>
   <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
    <Setter Property="Margin" Value="1,30,0,6"/>
   </Style>
   <Style x:Key="GalleryCardStyle" TargetType="Border">
    <Setter Property="Padding" Value="20"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
