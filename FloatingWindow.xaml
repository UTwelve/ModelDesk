<Window x:Class="ModelDesk.FloatingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ModelDesk" Title="ModelDesk · 悬浮监控">
 <Grid x:Name="RootGrid" Background="Transparent">
  <Grid.Resources>
   <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
   <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
   <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
   <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush"/>
   <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlFillColorSecondaryBrush"/>
   <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush"/>
   <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ControlFillColorTertiaryBrush"/>
   <Style x:Key="CaptionPinStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition x:Name="CaptionRow" Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderGrid" Background="Transparent" Margin="16,0,184,0"><TextBlock Text="ModelDesk · 悬浮监控" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
  <ToggleButton x:Name="PinButton" Style="{StaticResource CaptionPinStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="46" Height="32" Margin="0,0,138,0" IsChecked="True" Click="Pin_Click" AutomationProperties.Name="取消窗口置顶" ToolTipService.ToolTip="已置顶 · 点击取消">
   <FontIcon x:Name="PinIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE718;" FontSize="12"/>
  </ToggleButton>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Padding="16,8,16,16" Spacing="10">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StateText" Text="尚未连接" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/><Button Grid.Column="1" Content="主窗口" Click="Restore_Click" Padding="8,4"/></Grid>
    <TextBlock x:Name="SummaryText" Text="等待任务采样" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4"><TextBlock Text="生成速度" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="GenerationText" Text="— token/s" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
     <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,4" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="活跃任务" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="SlotsText" Text="—" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></Border>
    </Grid>
    <TextBlock x:Name="UpdatedText" Text="等待首次采样" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
    <Border x:Name="PromptStageBar" Visibility="Collapsed" Padding="10,6" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"><TextBlock x:Name="PromptStageText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></Border>
    <local:SpeedChart x:Name="Chart" Height="120"/>
    <TextBlock x:Name="GpuSummaryText" Text="GPU — · 温度 — · 显存 —" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
    <Expander Header="显卡与采集来源" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock x:Name="GpuDetailText" Text="正在读取显卡与采集来源…" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/></Expander>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
